API_KEY=change-me
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX

# Email notifications (complaint status changes). Leave SMTP_HOST unset to
# just print emails to the console instead — no mail server needed locally.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# SMTP_USE_TLS=true
# EMAIL_FROM=roadwatch@example.com

# Dataset management staging area (defaults to data/pothole_dataset/uploaded)
# DATASET_UPLOAD_DIR=/path/to/uploaded
